# ===========================================
# Billing Tracker Configuration
# Copy this to .env and fill in your values
# ===========================================

# Anthropic API Key (for Claude Vision receipt scanning)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google Sheet ID (from your spreadsheet URL)
# Example URL: https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=19WE81Vj3O8cvI7mvXl1zIggEuesGvIiX

# Gmail label to watch for billing emails (default: all inbox)
GMAIL_BILLING_LABEL=INBOX

# How often to check for new emails (in minutes)
EMAIL_CHECK_INTERVAL=30

# Folder to watch for new receipt photos
RECEIPT_WATCH_FOLDER=./receipts

# Google Sheet tab name
SHEET_TAB_NAME=Sheet1
