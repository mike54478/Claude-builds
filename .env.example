# App
APP_URL=http://localhost:3000
CRON_SECRET=change-me # protects /api/cron/* routes

# Database (Neon Postgres)
DATABASE_URL=postgres://user:pass@host/repruv

# Auth (better-auth)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Anthropic — AI sentiment analysis & response drafting
ANTHROPIC_API_KEY=sk-ant-...

# Twilio — SMS review requests & two-way messaging
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG... # A2P 10DLC registered messaging service

# Resend — transactional email
RESEND_API_KEY=re_...
EMAIL_FROM="Repruv <requests@mail.repruv.com>"

# Stripe — per-location subscription billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_... # $99/location/mo
STRIPE_PRICE_PRO=price_...     # $179/location/mo
